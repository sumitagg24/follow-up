# ── Deployment mode ──────────────────────────────────────────────
# NODE_ENV=development (default): localhost CORS, dev JWT fallback,
# in-memory MongoDB fallback, verbose 500 errors.
# NODE_ENV=production: MONGODB_URI, JWT_SECRET (32+ random chars), and
# CLIENT_URL are REQUIRED — the server refuses to boot without them, never
# falls back to in-memory storage, and returns generic 500 messages.
NODE_ENV=development

# ── Persistence ────────────────────────────────────────────────────
# Optional in development (in-memory fallback). REQUIRED in production.
MONGODB_URI=mongodb://localhost:27017/founder-followup

# ── Auth ───────────────────────────────────────────────────────────
# Optional in development (insecure dev fallback). REQUIRED in production:
# minimum 32 random characters, e.g. from `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# Tokens expire after 7 days; invalid/expired tokens get 401.
JWT_SECRET=

PORT=4000

# ── CORS ───────────────────────────────────────────────────────────
# Optional in development (defaults to http://localhost:5173).
# REQUIRED in production: exact origin of the deployed frontend, e.g.
# https://app.example.com. No fallback is applied in production.
CLIENT_URL=http://localhost:5173

# ── Email (all optional) ───────────────────────────────────────────
# Leave SMTP_HOST/USER/PASS empty for dev-mode logging: reminders are
# written to the server console and recorded as `reminder_email_dev`
# activities. NOTHING IS DELIVERED unless SMTP is actually configured.
# With SMTP set, deliveries are recorded as `reminder_email_sent` and
# failures as `reminder_email_failed` — `emailsSent` only counts real sends.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Dev seed ───────────────────────────────────────────────────────
# POST /api/seed always requires a session token. In production it is
# additionally disabled unless ALLOW_SEED=true. Leave unset normally.
ALLOW_SEED=
